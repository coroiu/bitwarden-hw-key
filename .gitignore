# Generated by `cargo run -p bhk-core --example render_scene` (W3 render
# core PNG-dump verification) — an artifact, not source.
render_scene.png

# Generated by `cargo run -p emulator --example render_via_surfaces` (W4
# host-surface parity verification) — an artifact, not source.
headless_scene.png

# Beads task tracking: .beads/ has its own .gitignore that ignores the
# ephemeral bits (sqlite db/WAL, daemon, socket) while keeping issues.jsonl
# and config tracked, so task history is shared via git. Do NOT blanket-ignore
# .beads/ here — it would override that and make the board local-only.
.mcp.json

# local git worktrees for bead work
.worktrees/
